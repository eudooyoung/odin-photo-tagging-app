// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Geek {
  id     Int    @id
  name   String @unique
  x      Int
  y      Int
  width  Int
  height Int

  games GeeksOnGames[]
}

model Game {
  id         Int       @id @default(autoincrement())
  publicId   String    @unique @default(uuid())
  player     String?   @unique
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  record     Int?

  targets GeeksOnGames[]
}

model GeeksOnGames {
  geek    Geek    @relation(fields: [geekId], references: [id])
  geekId  Int
  game    Game    @relation(fields: [gameId], references: [id])
  gameId  Int
  isFound Boolean @default(false)

  @@id([geekId, gameId])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
